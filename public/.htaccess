RedirectMatch 301 ^/posts/(.+)$ https://archive.stuartlee.org/posts/$1

# Security headers. Wrapped so a host without mod_headers degrades to
# "no headers" rather than a 500.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=15552000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"

  # This site ships no JavaScript and no inline styles: everything is
  # self-hosted under /_astro/. Scripts are blocked by default-src 'none'.
  Header always set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
</IfModule>
